# Database: una cartella dove l'app salva videocall.json (su Coolify DATA_DIR=/data, con un volume montato in /data).
# In alternativa Supabase (Project Settings → API): se ci sono le due variabili Supabase vince Supabase.
# Senza nessuna delle due l'app gira in modalità demo (dati in memoria).
DATA_DIR=./data
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# LiveKit: sul proprio server (deploy/livekit, LIVEKIT_URL = wss://indirizzo-dell-app) oppure LiveKit Cloud
# (Settings → Project per l'URL, Settings → API Keys per chiave e segreto)
LIVEKIT_URL=wss://call.tuosito.it
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Una frase lunga e casuale (firma il cookie di accesso)
SESSION_SECRET=

# Organizzatori: utente:password separati da ;
VIDEO_ORGANIZERS=mario:password1;anna:password2
